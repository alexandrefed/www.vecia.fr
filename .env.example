# Local development values for the comment system. Production secrets live in Infisical (/vecia-website).
# Copy to .env; never commit .env.

COMMENTS_DB_PATH=./data/comments.db
MODERATION_HMAC_KEY=dev-only-change-me
IP_HASH_SALT=dev-only-change-me
# Without a key the moderator answers "queue" for everything.
ANTHROPIC_API_KEY=
# shadow (default): everything waits for a human, the model's verdict is recorded. live: act on the verdict.
MODERATION_MODE=shadow
NTFY_URL=https://ntfy.vecia.fr
NTFY_TOPIC=alex-alerts
NTFY_TOKEN=
SITE_URL=http://localhost:4321
