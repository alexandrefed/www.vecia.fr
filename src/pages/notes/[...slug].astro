---
import DetailView from '../../components/views/DetailView.astro';
import { findBySlug } from '../../lib/content';

const entry = await findBySlug('notes', 'en', Astro.params.slug ?? '');
if (!entry) return new Response(null, { status: 404, statusText: 'Not found' });
---

<DetailView section="notes" entry={entry} lang="en" />
