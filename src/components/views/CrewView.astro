---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Language } from '../../i18n/ui';
import { site as siteEn } from '../../i18n/en/site';
import { site as siteFr } from '../../i18n/fr/site';
import { allPeople } from '../../lib/content';
import { personUrl } from '../../lib/people';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const site = lang === 'fr' ? siteFr : siteEn;
const people = await allPeople();
---

<BaseLayout title={`${site.home.crew.title} — Vecia`} description={site.home.crew.intro} lang={lang}>
  <section class="pt-[110px] pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-8">
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-6">{site.home.crew.title}</h1>
      <p class="text-lg text-muted leading-relaxed mb-12 max-w-3xl">{site.home.crew.intro}</p>
      <div class="grid gap-6 md:grid-cols-2">
        {people.map((p) => (
          <a href={personUrl(p.data.subdomain, lang)} class="block p-6 bg-white rounded-2xl border border-gray-200 hover:border-primary/40 hover:shadow-lg transition-all">
            <h2 class="text-2xl font-display font-bold text-text mb-1">{p.data.name}</h2>
            <p class="text-sm font-medium text-primary mb-4">{p.data.role[lang]}</p>
            <p class="text-muted leading-relaxed">{p.data.bio[lang]}</p>
          </a>
        ))}
      </div>
      <p class="mt-8 text-muted italic">{site.home.crew.more}</p>
    </div>
  </section>
</BaseLayout>
