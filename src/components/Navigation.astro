---
import type { Language } from '../i18n/ui';
import { getRelativeLocaleUrl, alternatePath } from '../i18n/utils';
import { site as siteEn } from '../i18n/en/site';
import { site as siteFr } from '../i18n/fr/site';

interface Props {
  lang: Language;
  /** Override the other-language URL (translated note slugs, person subdomains). */
  altLangUrl?: string;
}

const { lang, altLangUrl: altLangUrlProp } = Astro.props;
const site = lang === 'fr' ? siteFr : siteEn;

const url = (path: string) => getRelativeLocaleUrl(lang, path);
const homeUrl = lang === 'fr' ? '/fr/' : '/';
const altLangUrl = altLangUrlProp ?? alternatePath(Astro.url.pathname);

const links = [
  { href: url('notes'), label: site.nav.notes },
  { href: url('cases'), label: site.nav.cases },
  { href: url('workshop'), label: site.nav.workshop },
  { href: url('crew'), label: site.nav.crew },
];
const officeHoursUrl = url('office-hours');
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-background/0 backdrop-blur-md border-b border-gray-200/20 h-[70px]" x-data="{ mobileOpen: false }">
  <div class="w-full h-full px-8">
    <div class="flex items-center justify-between h-full">

      <!-- Logo -->
      <a href={homeUrl} class="flex items-center group">
        <img
          src="/vecia_logo_long_contour.png"
          alt="Vecia"
          class="h-10 w-auto hidden lg:block transition-transform group-hover:scale-105"
        />
        <img
          src="/vecia_favicon.png"
          alt="Vecia"
          class="h-10 w-auto lg:hidden transition-transform group-hover:scale-105"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-7">
        {links.map((l) => (
          <a href={l.href} class="text-base font-display font-bold uppercase tracking-wide text-muted hover:text-primary transition-colors">
            {l.label}
          </a>
        ))}

        <a
          href={altLangUrl}
          hreflang={lang === 'fr' ? 'en' : 'fr'}
          lang={lang === 'fr' ? 'en' : 'fr'}
          aria-label={site.ui.language}
          class="text-sm font-medium px-3 py-1 rounded-md text-muted hover:text-primary transition-colors"
        >
          {site.nav.switchLang}
        </a>

        <a
          href={officeHoursUrl}
          class="px-6 py-2.5 text-base font-semibold rounded-lg text-white bg-gradient-to-r from-primary to-secondary hover:scale-105 hover:shadow-lg transition-all"
        >
          {site.nav.officeHours}
        </a>
      </div>

      <!-- Mobile Menu Button (Alpine.js toggles the open state) -->
      <button
        @click="mobileOpen = !mobileOpen"
        class="lg:hidden p-2.5 text-muted hover:text-primary transition-colors relative"
        aria-label={site.ui.menu}
      >
        <svg
          x-show="!mobileOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 rotate-90"
          x-transition:enter-end="opacity-100 rotate-0"
          class="w-7 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          x-show="mobileOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 rotate-90"
          x-transition:enter-end="opacity-100 rotate-0"
          class="w-7 h-6 absolute top-2.5 left-2.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      x-show="mobileOpen"
      @click.outside="mobileOpen = false"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 transform -translate-y-4"
      x-transition:enter-end="opacity-100 transform translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 transform translate-y-0"
      x-transition:leave-end="opacity-0 transform -translate-y-4"
      class="lg:hidden mt-6 py-8 px-6 bg-white shadow-2xl rounded-b-2xl"
      style="display: none;"
    >
      <div class="flex flex-col gap-6 items-center">
        {links.map((l) => (
          <a href={l.href} class="text-lg font-display font-bold uppercase tracking-wide text-muted hover:text-primary transition-all hover:scale-105 text-center py-2">
            {l.label}
          </a>
        ))}

        <div class="flex gap-6 pt-4 mt-4 border-t border-gray-100 text-center w-full justify-center">
          <a
            href={altLangUrl}
            hreflang={lang === 'fr' ? 'en' : 'fr'}
            lang={lang === 'fr' ? 'en' : 'fr'}
            class="text-base text-muted hover:text-primary transition-colors font-medium"
          >
            {site.nav.switchLang}
          </a>
        </div>

        <a
          href={officeHoursUrl}
          class="w-full px-6 py-4 text-lg font-semibold rounded-xl text-white bg-gradient-to-r from-primary to-secondary hover:scale-[1.02] active:scale-[0.98] hover:shadow-xl transition-all text-center"
        >
          {site.nav.officeHours}
        </a>
      </div>
    </div>
  </div>
</nav>
