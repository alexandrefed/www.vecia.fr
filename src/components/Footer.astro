---
import type { Language } from '../i18n/ui';
import { getRelativeLocaleUrl } from '../i18n/utils';
import { site as siteEn } from '../i18n/en/site';
import { site as siteFr } from '../i18n/fr/site';
import { config } from '../config';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const site = lang === 'fr' ? siteFr : siteEn;
const route = (path: string) => getRelativeLocaleUrl(lang, path);

const legal = [
  { href: route('privacy'), label: site.footer.privacy },
  { href: route('terms'), label: site.footer.terms },
  { href: route('cookies'), label: site.ui.cookies },
  { href: route('ai-ethics'), label: site.ui.aiEthics },
];
const feeds = [
  { href: '/rss.xml', label: 'RSS' },
  { href: '/feed.json', label: 'JSON' },
  { href: '/llms.txt', label: 'llms.txt' },
];
---

<footer class="bg-white border-t border-gray-100 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8 lg:gap-0">

      <!-- Left: logo + tagline -->
      <div class="flex flex-col items-center lg:items-start gap-3">
        <img
          src="/vecia_logo_long_contour.png"
          alt="Vecia"
          class="h-8 w-auto"
        />
        <p class="text-sm text-muted">{site.footer.tagline}</p>
      </div>

      <!-- Center: legal links -->
      <nav class="flex flex-wrap gap-x-8 gap-y-3 justify-center" aria-label={site.ui.footerNav}>
        {legal.map((l) => (
          <a href={l.href} class="text-sm font-medium text-muted hover:text-primary transition-colors duration-200">
            {l.label}
          </a>
        ))}
      </nav>

      <!-- Right: feeds + LinkedIn -->
      <div class="flex flex-col items-center lg:items-end gap-3">
        <p class="text-xs text-subtle flex gap-3" aria-label={site.footer.feeds}>
          {feeds.map((f) => <a href={f.href} class="hover:text-primary transition-colors">{f.label}</a>)}
        </p>
        <a
          href={config.social.linkedin}
          class="text-sm font-medium text-muted hover:text-primary transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.ui.social}
        </a>
      </div>
    </div>
  </div>
</footer>
