---
/**
 * ArticleFooter Component
 *
 * End of a note / case / log: who wrote it (linked to their page), a pointer
 * to office hours, and the translation link when one exists.
 */

import { getCollection } from 'astro:content';
import type { Language } from '../../i18n/ui';
import { site as siteEn } from '../../i18n/en/site';
import { site as siteFr } from '../../i18n/fr/site';
import { personUrl } from '../../lib/people';
import { getRelativeLocaleUrl } from '../../i18n/utils';

interface Props {
  /** Person subdomain, e.g. 'alexandre'. */
  author: string;
  lang: Language;
  /** URL of the same entry in the other language, if translationSlug resolved. */
  translationUrl?: string;
}

const { author, lang, translationUrl } = Astro.props;
const site = lang === 'fr' ? siteFr : siteEn;
const person = (await getCollection('people')).find((p) => p.data.subdomain === author);
---

<footer class="mt-16 space-y-8">
  <div class="border-t border-gray-200"></div>

  {person && (
    <div class="bg-gradient-to-br from-accent3 to-white p-8 rounded-2xl border border-gray-200">
      <p class="text-sm text-muted mb-1">{site.ui.by}</p>
      <h3 class="text-lg font-heading font-bold text-text mb-2">
        <a href={personUrl(person.data.subdomain, lang)} class="hover:text-primary transition-colors">{person.data.name}</a>
      </h3>
      <p class="text-muted">{person.data.role[lang]}</p>
    </div>
  )}

  <div class="flex flex-wrap items-center gap-6 text-sm">
    <a href={getRelativeLocaleUrl(lang, 'office-hours')} class="font-semibold text-primary hover:underline">
      {site.nav.officeHours}
    </a>
    {translationUrl && (
      <a href={translationUrl} class="text-muted hover:text-primary transition-colors">
        {site.ui.readTranslation}
      </a>
    )}
  </div>
</footer>
