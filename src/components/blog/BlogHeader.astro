---
/**
 * BlogHeader Component
 *
 * Header for note / case / log detail pages: breadcrumb, title, description,
 * author, date, reading time, tags.
 */

import type { Language } from '../../i18n/ui';
import { site as siteEn } from '../../i18n/en/site';
import { site as siteFr } from '../../i18n/fr/site';

interface Props {
  title: string;
  description?: string;
  author: string;
  date: Date;
  tags?: string[];
  lang: Language;
  readingTime: number;
  /** Section index this page belongs to, for the breadcrumb (e.g. /notes). */
  indexPath: string;
  indexLabel: string;
}

const { title, description, author, date, tags = [], lang, readingTime, indexPath, indexLabel } = Astro.props;
const site = lang === 'fr' ? siteFr : siteEn;

const formattedDate = date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const homeLabel = site.ui.home;
const homePath = lang === 'fr' ? '/fr/' : '/';
const isVeciaTeam = false;
---

<!-- Breadcrumb Navigation -->
<nav class="mb-6" aria-label="Breadcrumb">
  <ol class="flex items-center space-x-2 text-sm text-muted">
    <li>
      <a href={homePath} class="hover:text-primary transition-colors">
        {homeLabel}
      </a>
    </li>
    <li>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
      </svg>
    </li>
    <li>
      <a href={indexPath} class="hover:text-primary transition-colors">
        {indexLabel}
      </a>
    </li>
    <li>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
      </svg>
    </li>
    <li class="text-text font-medium" aria-current="page">
      {title.length > 50 ? title.substring(0, 50) + '...' : title}
    </li>
  </ol>
</nav>

<!-- Article Header -->
<header class="mb-8">
  <!-- Title -->
  <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-text leading-tight mb-4">
    {title}
  </h1>

  <!-- Description -->
  {description && (
    <p class="text-xl text-text leading-relaxed mb-6 max-w-3xl">
      {description}
    </p>
  )}

  <!-- Metadata Row -->
  <div class="flex flex-wrap items-center gap-4 text-sm text-muted mb-6">
    <!-- Author -->
    <div class="flex items-center">
      {isVeciaTeam ? (
        <img
          src="/vecia_favicon.png"
          alt="Vecia Team"
          class="w-5 h-5 mr-2 rounded object-cover"
          loading="eager"
          onerror="this.style.display='none'"
        />
      ) : (
        <svg class="w-5 h-5 mr-2 text-subtle" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
        </svg>
      )}
      <span class="font-medium text-text">{author}</span>
    </div>

    <!-- Divider -->
    <span class="text-subtle">•</span>

    <!-- Publish Date -->
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2 text-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <time datetime={date.toISOString()}>
        {formattedDate}
      </time>
    </div>

    <!-- Divider -->
    <span class="text-subtle">•</span>

    <!-- Reading Time -->
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2 text-subtle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{readingTime} {site.ui.minRead}</span>
    </div>
  </div>

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-muted border border-gray-200 hover:bg-gray-200 transition-colors">
          <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
          {tag}
        </span>
      ))}
    </div>
  )}
</header>

<!-- Divider -->
<div class="border-t border-gray-200 mb-8"></div>
