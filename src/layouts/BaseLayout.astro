---
/**
 * BaseLayout - SEO layout for every page.
 *
 * - Open Graph + Twitter Card meta
 * - hreflang alternates (en at /x, fr at /fr/x) via alternatePath()
 * - JSON-LD Organization + WebSite
 * - Google Analytics 4 (Consent Mode V2) behind the cookie banner
 */

import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { alternatePath } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'fr' | 'en';
  /** Absolute canonical URL; defaults to the current URL on the site origin. */
  canonical?: string;
  /** Absolute or site-relative path to the share image. */
  ogImage?: string;
  noindex?: boolean;
  /** Counterpart URL in the other language when slugs differ (translated notes). Otherwise path-swap. */
  altLangUrl?: string;
  breadcrumbData?: { items: Array<{ name: string; url: string }> };
}

const { title, description, lang, canonical, ogImage: ogImageProp, noindex = false, altLangUrl, breadcrumbData } = Astro.props;

const site = Astro.site || new URL('https://vecia.fr');
const canonicalURL = canonical ? new URL(canonical, site) : new URL(Astro.url.pathname, site);
const ogImage = new URL(ogImageProp ?? '/vecia_logo_long_contour.png', site);

// hreflang: path-swap unless a translated slug is given
const here = Astro.url.pathname;
const otherUrl = new URL(altLangUrl ?? alternatePath(here), site);
const enURL = lang === 'en' ? new URL(here, site) : otherUrl;
const frURL = lang === 'fr' ? new URL(here, site) : otherUrl;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Vecia',
  url: String(site),
  logo: String(new URL('/vecia_logo_long_contour.png', site)),
  description,
  sameAs: ['https://www.linkedin.com/company/vecia'],
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator}>

    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex, nofollow">}

    <link rel="canonical" href={canonicalURL}>
    <link rel="alternate" hreflang="en" href={enURL}>
    <link rel="alternate" hreflang="fr" href={frURL}>
    <link rel="alternate" hreflang="x-default" href={enURL}>
    <link rel="alternate" type="application/rss+xml" title="Vecia" href="/rss.xml">
    <link rel="alternate" type="application/feed+json" title="Vecia" href="/feed.json">
    <link rel="sitemap" href="/sitemap-index.xml">

    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'}>
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'}>
    <meta property="og:site_name" content="Vecia">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={canonicalURL}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <link rel="icon" type="image/png" href="/vecia_favicon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">

    <!-- Hugeicons Icon Font -->
    <link rel="stylesheet" href="https://use.hugeicons.com/font/icons.css">

    <!-- Client-side scripts (Alpine.js) - bundled by Astro -->
    <script>
      import '../scripts/client.ts';
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <StructuredData
      type="website"
      data={{
        name: 'Vecia',
        url: String(site),
        description: description,
      }}
    />

    <!-- Google Analytics 4 with Consent Mode V2 -->
    <GoogleAnalytics />

    {breadcrumbData && <StructuredData type="breadcrumb" data={breadcrumbData} />}

    <slot name="head" />
  </head>

  <body class="font-body text-text bg-background">
    <Navigation lang={lang} altLangUrl={altLangUrl} />

    <main>
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- Cookie Consent Banner (GA4 needs consent under French law) -->
    <CookieConsent />
  </body>
</html>
